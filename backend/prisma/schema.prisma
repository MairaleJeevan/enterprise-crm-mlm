datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  password     String
  firstName    String
  lastName     String?
  role         String      // ADMIN, STORE_USER, MLM_DISTRIBUTOR
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  storeUsers   StoreUser[]
  sales        Sale[]
  mlmNode      MlmNode?
  commissions  Commission[]
  payouts      Payout[]
}

model StoreUser {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  role        String    // MANAGER, CASHIER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, franchiseId])
}

model Franchise {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      String   // SHOWROOM, FRANCHISE
  address   String?
  city      String?
  state     String?
  country   String
  pincode   String?
  phone     String?
  email     String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users     StoreUser[]
  customers Customer[]
  products  Product[]
  sales     Sale[]
  inventories Inventory[]
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String
  address   String?
  city      String?
  state     String?
  pincode   String?
  franchiseId String?
  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  isGoldMember Boolean @default(false)
  goldCardId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sales     Sale[]
  vehicles  Vehicle[]
  followUps FollowUp[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  purchasePrice Float
  sellingPrice Float
  taxRate     Float
  unit        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  inventory   Inventory?
  saleItems   SaleItem[]
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  quantity    Int      @default(0)
  reorderLevel Int     @default(0)
  maxLevel    Int?
  location    String?
  lastUpdated DateTime @default(now())
}

model Sale {
  id          String   @id @default(cuid())
  invoiceNumber String @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  saleDate    DateTime @default(now())
  subtotal    Float
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float
  goldCardId  String?
  paymentStatus String // PENDING, PAID, FAILED
  paymentMethod String?
  transactionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       SaleItem[]
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  discount    Float    @default(0)
  total       Float
}

model MlmNode {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  parentId    String?   // Sponsor (Direct Recruiter) / Upline ID
  parent      MlmNode?  @relation("MlmHierarchy", fields: [parentId], references: [id])
  children    MlmNode[] @relation("MlmHierarchy")
  
  // Placement Tree fields (if Binary structure)
  placementId String?   
  placement   MlmNode?  @relation("MlmPlacement", fields: [placementId], references: [id])
  placementChildren MlmNode[] @relation("MlmPlacement")
  position    String?   // LEFT, RIGHT (if Binary)
  
  rank        String    @default("Sales Advisor") // Sales Advisor, Team Leader (TL), Team Manager, Founder Member
  personalPv  Float     @default(0.0) // Personal Sales Volume
  groupPv     Float     @default(0.0) // Cumulative Downline Sales Volume
  leftPv      Float     @default(0.0) // Left leg PV (for Binary match)
  rightPv     Float     @default(0.0) // Right leg PV (for Binary match)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Commission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amount      Float
  type        String    // DIRECT_SPONSOR, BINARY_MATCH, RANK_BONUS
  description String?
  status      String    @default("PENDING") // PENDING, PAID
  saleId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payout {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amount      Float
  status      String    @default("PENDING") // PENDING, PAID
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vehicle {
  id            String     @id @default(cuid())
  make          String
  modelName     String
  year          Int
  licensePlate  String     @unique
  vin           String?    @unique
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model FollowUp {
  id            String     @id @default(cuid())
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notes         String
  status        String     @default("PENDING") // PENDING, COMPLETED, CANCELLED
  followUpDate  DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Reminder {
  id            String     @id @default(cuid())
  title         String
  description   String?
  remindAt      DateTime
  isCompleted   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  password     String
  firstName    String
  lastName     String?
  role         String      // ADMIN, STORE_USER, MLM_DISTRIBUTOR
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  storeUsers      StoreUser[]
  sales           Sale[]
  mlmNode         MlmNode?
  commissions     Commission[]
  payouts         Payout[]
  advisorPayments Payment[]
  customerProfile Customer?    // Gold Card holder account

  // MLM Enhancements
  referralCode        String?              @unique
  kycStatus           String               @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED
  exitDate            DateTime?
  exitReason          String?
  kyc                 MemberKYC?
  heldCommissions     HeldCommission[]
  commissionReleases  CommissionRelease[]
  founderTracking     FounderTracking?
  policies            Policy[]
  referral            Referral?
  memberAwards        MemberAward[]
  founderAppointments FounderAppointment[]
  welcomeCallSchedules WelcomeCallSchedule[]
  notifications       Notification[]
}

model StoreUser {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  role        String    // MANAGER, CASHIER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, franchiseId])
}

model Franchise {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      String   // SHOWROOM, FRANCHISE
  address   String?
  city      String?
  state     String?
  country   String
  pincode   String?
  phone     String?
  email     String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users     StoreUser[]
  customers Customer[]
  products  Product[]
  sales     Sale[]
  inventories Inventory[]
}

model Customer {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String
  address   String?
  city      String?
  state     String?
  pincode   String?
  franchiseId String?
  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  isGoldMember Boolean @default(false)
  goldCardId String?
  userId    String?   @unique   // linked User account (created on Gold Card purchase)
  user      User?     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sales     Sale[]
  vehicles  Vehicle[]
  followUps FollowUp[]
  goldCards GoldCard[]
  payments  Payment[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  purchasePrice Float
  sellingPrice Float
  taxRate     Float
  unit        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  inventory   Inventory?
  saleItems   SaleItem[]
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  quantity    Int      @default(0)
  reorderLevel Int     @default(0)
  maxLevel    Int?
  location    String?
  lastUpdated DateTime @default(now())
}

model Sale {
  id          String   @id @default(cuid())
  invoiceNumber String @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  saleDate    DateTime @default(now())
  subtotal    Float
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float
  goldCardId  String?
  paymentStatus String // PENDING, PAID, FAILED
  paymentMethod String?
  transactionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  items       SaleItem[]
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  discount    Float    @default(0)
  total       Float
}

model MlmNode {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  parentId    String?   // Sponsor (Direct Recruiter) / Upline ID
  parent      MlmNode?  @relation("MlmHierarchy", fields: [parentId], references: [id])
  children    MlmNode[] @relation("MlmHierarchy")
  
  // Placement Tree fields (if Binary structure)
  placementId String?   
  placement   MlmNode?  @relation("MlmPlacement", fields: [placementId], references: [id])
  placementChildren MlmNode[] @relation("MlmPlacement")
  position    String?   // LEFT, RIGHT (if Binary)
  
  rank        String    @default("Sales Advisor") // Sales Advisor, Team Leader (TL), Team Manager, Founder Member
  personalPv  Float     @default(0.0) // Personal Sales Volume
  groupPv     Float     @default(0.0) // Cumulative Downline Sales Volume
  leftPv      Float     @default(0.0) // Left leg PV (for Binary match)
  rightPv     Float     @default(0.0) // Right leg PV (for Binary match)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Commission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amount      Float
  type        String    // DIRECT_SPONSOR, BINARY_MATCH, RANK_BONUS
  description String?
  status      String    @default("PENDING") // PENDING, PAID
  saleId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Payout {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amount      Float
  status      String    @default("PENDING") // PENDING, PAID
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vehicle {
  id            String     @id @default(cuid())
  make          String
  modelName     String
  year          Int
  licensePlate  String     @unique
  vin           String?    @unique
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model FollowUp {
  id            String     @id @default(cuid())
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  notes         String
  status        String     @default("PENDING") // PENDING, COMPLETED, CANCELLED
  followUpDate  DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Reminder {
  id            String     @id @default(cuid())
  title         String
  description   String?
  remindAt      DateTime
  isCompleted   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Payment {
  id                  String    @id @default(cuid())
  razorpayOrderId     String    @unique
  razorpayPaymentId   String?   @unique
  razorpaySignature   String?
  amount              Float
  currency            String    @default("INR")
  status              String    @default("PENDING") // PENDING, CAPTURED, FAILED, REFUNDED
  paymentMethod       String?
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id])
  advisorId           String
  advisor             User      @relation(fields: [advisorId], references: [id])
  franchiseId         String?
  failureReason       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  goldCard            GoldCard?
  invoice             GoldInvoice?
}

model GoldCard {
  id             String    @id @default(cuid())
  cardNumber     String    @unique
  uniqueUID      String    @unique @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  paymentId      String    @unique
  payment        Payment   @relation(fields: [paymentId], references: [id])
  activationDate DateTime  @default(now())
  expiryDate     DateTime
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED
  qrCode         String?   // base64 encoded QR
  createdAt      DateTime  @default(now())
}

model GoldInvoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  paymentId     String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id])
  customerId    String
  subtotal      Float
  tax           Float
  total         Float
  createdAt     DateTime  @default(now())
}

model MemberKYC {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  
  // Aadhar Details
  aadharNumber        String?
  aadharFrontFile     String?   // Base64
  aadharBackFile      String?   // Base64
  aadharVerified      Boolean   @default(false)
  
  // PAN Details
  panNumber           String?
  panFile             String?   // Base64
  panVerified         Boolean   @default(false)
  
  // Bank Details
  accountNumber       String?
  ifscCode            String?
  bankName            String?
  branchName          String?
  accountHolder       String?
  bankVerified        Boolean   @default(false)
  
  // References
  ref1Name            String?
  ref1Phone           String?
  ref1Relationship    String?
  ref2Name            String?
  ref2Phone           String?
  ref2Relationship    String?
  
  // Nominee Details
  nomineeName         String?
  nomineeRelationship String?
  nomineeAge          Int?
  nomineePhone        String?
  nomineeAddress      String?
  
  status              String    @default("PENDING") // PENDING, SUBMITTED, VERIFIED, REJECTED
  submittedAt         DateTime?
  verifiedAt          DateTime?
  verifiedBy          String?   // User ID of verified admin
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model HeldCommission {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  amount            Float
  sponsoredMemberId String?
  directMemberCount Int?
  status            String    @default("HELD") // HELD, RELEASED
  heldDate          DateTime  @default(now())
  releasedDate      DateTime?
  releaseReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CommissionRelease {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  totalHeldAmount Float
  releasedAmount  Float
  releaseDate     DateTime  @default(now())
  releaseType     String    // AUTO_RELEASE, MANUAL_RELEASE
  triggeredBy     String    // SYSTEM, ADMIN
  status          String    @default("PROCESSED")
  createdAt       DateTime  @default(now())
}

model FounderTracking {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  totalEarnings     Float     @default(0.0)
  currentIncome     Float     @default(0.0)
  exitThreshold     Float     @default(25900000) // ₹2.59 Crore
  exitTriggered     Boolean   @default(false)
  exitDate          DateTime?
  exitMessage       String?
  certificateNumber String?
  certificateFile   String?
  farewellPackage   String?   // JSON string
  recognitionVideo  String?
  exitBonus         Float?
  exitBonusPaid     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Policy {
  id                        String    @id @default(cuid())
  policyNumber              String    @unique
  userId                    String
  user                      User      @relation(fields: [userId], references: [id])
  policyType                String    // Life, Health, Term, Endowment
  coverageAmount            Float
  premiumAmount             Float
  premiumFrequency          String    // Monthly, Quarterly, Yearly
  startDate                 DateTime
  endDate                   DateTime
  status                    String    @default("PENDING") // PENDING, ACTIVE, EXPIRED, CANCELLED
  policyDocument            String?   // Base64 or URL
  policySummary             String?   // JSON String
  underwrittenBy            String?
  underwrittenAt            DateTime?
  policyHolderName          String?
  policyHolderDob           DateTime?
  policyHolderAddress       String?
  policyNomineeName         String?
  policyNomineeRelationship String?
  assignedBy                String?
  assignedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Referral {
  id                  String            @id @default(cuid())
  referralCode        String            @unique
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id])
  totalReferrals      Int               @default(0)
  successfulReferrals Int               @default(0)
  referralEarnings    Float             @default(0.0)
  qrCode              String?           // Base64 QR code image
  expiryDate          DateTime?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  histories           ReferralHistory[]
}

model ReferralHistory {
  id               String   @id @default(cuid())
  referralId       String
  referral         Referral @relation(fields: [referralId], references: [id])
  referredMemberId String
  commissionAmount Float?
  status           String   @default("PENDING") // PENDING, PAID
  createdAt        DateTime @default(now())
}

model Award {
  id           String        @id @default(cuid())
  name         String
  description  String?
  category     String        // Performance, Milestone, Leadership, Special
  type         String        // Trophy, Cash, Voucher, Trip, Electronic, Gift
  value        Float?
  image        String?
  criteria     String?       // JSON String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberAwards MemberAward[]
}

model MemberAward {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  awardId           String
  award             Award     @relation(fields: [awardId], references: [id])
  achievedDate      DateTime  @default(now())
  presentedBy       String?
  presentationDate  DateTime?
  certificateNumber String?
  certificateFile   String?
  status            String    @default("EARNED") // EARNED, CLAIMED, DELIVERED
  claimedAt         DateTime?
  deliveryDetails   String?   // JSON String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model FounderAppointment {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  appointmentFee   Float     @default(25900000)
  paymentStatus    String    @default("PENDING") // PENDING, PARTIAL, COMPLETED
  paymentDetails   String?   // JSON String
  appointedBy      String
  appointedAt      DateTime  @default(now())
  teamId           String?
  teamName         String?
  founderLevel     String    @default("FOUNDER")
  isActive         Boolean   @default(true)
  specialPrivileges String?   // JSON String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model JoiningFeeConfig {
  id            String    @id @default(cuid())
  amount        Float     @default(3500)
  currency      String    @default("INR")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  setBy         String?
  reason        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model JoiningFeeLog {
  id             String   @id @default(cuid())
  previousAmount Float?
  newAmount      Float
  changedBy      String?
  changedAt      DateTime @default(now())
  reason         String?
}

model WelcomeCallSchedule {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  scheduledDate DateTime
  status       String    @default("PENDING") // PENDING, COMPLETED, MISSED
  notes        String?
  assignedTo   String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   // INFO, SYSTEM, KYC, COMMISSION, PROMOTION, EXITED
  createdAt DateTime @default(now())
}

